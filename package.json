{
  "name": "@langgraph-toolkit/core",
  "version": "0.2.2",
  "description": "Framework-agnostic Langgraph-Toolkit core: typed graph builders, state, execution, streaming, interrupts, models and agents for any backend host.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    },
    "./low-level": {
      "types": "./dist/low-level.d.ts",
      "import": "./dist/low-level.js"
    },
    "./runtime": {
      "types": "./dist/runtime-barrel.d.ts",
      "import": "./dist/runtime-barrel.js"
    },
    "./queue": {
      "types": "./dist/queue-barrel.d.ts",
      "import": "./dist/queue-barrel.js"
    },
    "./testing": {
      "types": "./dist/testing-barrel.d.ts",
      "import": "./dist/testing-barrel.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Langgraph-Toolkit/core.git"
  }
}

{
  "name": "@langgraph-toolkit/core",
  "version": "0.1.1",
  "description": "Framework-agnostic LangGraph toolkit: defineGraph DSL, compile-time rule enforcement, run, stream, checkpointers and model registry. Works with any backend host.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Langgraph-Toolkit/core.git"
  }
}
